#
# Ansible managed
#
# http://prometheus.io/docs/operating/configuration/

global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s

  external_labels:
    environment: monitor

rule_files:
  - /etc/prometheus/rules/*.yml
  - /etc/prometheus/rules/*.yaml
  - /etc/prometheus/rules/*.rules


scrape_configs:
  - job_name: prometheus
    metrics_path: /metrics
    static_configs:
    - targets:
      - 127.0.0.1:9090

 #  ---- Node Exporters for all nodes
  - job_name: 'node_exporters'
    static_configs:
      - targets:
{% for host in groups['monitoried'] %}
        - '{{ hostvars[host]['ansible_host'] }}:9100'
{% endfor %}  
 # ------------------------------------------

 # ---- Nginx Exporter for Load balancer
 # - job_name: loadbalancer_nge
 #   static_configs:
 #   - targets: [ "{{ loadbalancer_nge }}"] 
 # ------------------------------------------

 # ---- Pantroni Exporter for DB nodes 
  - job_name: patroni-psql
    static_configs:
      - targets:
{% for host in groups['psql']  %}
        - '{{ hostvars[host]['ansible_host'] }}:8008'
{% endfor %}  
 
 # -----------------------------------------     

 # ---- PSQL Exporter for DB nodes 
  - job_name: psql
    static_configs:
      - targets:
{% for host in groups['psql']  %}
        - '{{ hostvars[host]['ansible_host'] }}:9187'
{% endfor %}  

 # ---- Kubernetes Kubernetes Cluster State Metrics Balancer 
    # ---- Kubernetes Cluster-Specific Metrics via HAProxy VIP
  - job_name: kubernetes-cluster-state
    static_configs:
      - targets:
        - '{{ k8s_cluster_state_metrics_balancer_ip }}' # <--- Keepalived VIP

scrape_config_files:
  - scrape_configs/*




